# Optional. The agent runs fully without this key -- the rules tier needs no
# model, and `make replay` serves every request from committed cassettes.
#
# Supplying a key enables the tier-2 LLM adjudicator, which is what resolves
# the ambiguous middle that rules alone cannot call. Free key, no billing:
#   https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Override if you want a different model for adjudication.
# GATEKEEPER_MODEL=gemini-2.5-flash-lite
